{
  "expo": {
    "name": "fitXball",
    "slug": "fitxball",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "fitxball",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#012E3F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fitxball.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#012E3F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.fitxball.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "static",
      "name": "fitXball",
      "shortName": "fitXball",
      "description": "Book courts. Find games. Play more."
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#C8FF00"
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
