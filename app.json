{
  "expo": {
    "name": "fitXball",
    "slug": "fitxball",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "fitxball",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/67fe4d76-0066-4b85-a3df-45724b83531a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fitxball.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#012E3F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.fitxball.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "static",
      "name": "fitXball",
      "shortName": "fitXball",
      "description": "Book courts. Find games. Play more."
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#C8FF00"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "fitXball uses the camera to scan entry QR codes when checking players in at events."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "fitXball needs access to your photos so you can set your profile picture and upload event images."
        }
      ],
      "expo-web-browser",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#012E3F"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "67fe4d76-0066-4b85-a3df-45724b83531a"
      }
    }
  }
}
